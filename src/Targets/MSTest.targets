<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 
    MSTest.targets
    Provides HintPaths for Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll
    from the ThirdParty\MSTest\ directory, eliminating the need for Visual Studio
    to be installed for builds to succeed.
    
    Run build\CopyMSTestFramework.ps1 to populate ThirdParty\MSTest\vXX\ directories.
  -->
  <Choose>
    <When Condition="'$(VisualStudioVersion)' == '10.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
          <Private>False</Private>
          <HintPath>$(MSBuildThisFileDirectory)..\ThirdParty\MSTest\v10\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition="'$(VisualStudioVersion)' == '11.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
          <Private>False</Private>
          <HintPath>$(MSBuildThisFileDirectory)..\ThirdParty\MSTest\v11\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition="'$(VisualStudioVersion)' == '12.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
          <Private>False</Private>
          <HintPath>$(MSBuildThisFileDirectory)..\ThirdParty\MSTest\v12\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition="'$(VisualStudioVersion)' == '14.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
          <Private>False</Private>
          <HintPath>$(MSBuildThisFileDirectory)..\ThirdParty\MSTest\v14\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition="'$(VisualStudioVersion)' == '15.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
          <Private>False</Private>
          <HintPath>$(MSBuildThisFileDirectory)..\ThirdParty\MSTest\v15\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition="'$(VisualStudioVersion)' == '16.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
          <Private>False</Private>
          <HintPath>$(MSBuildThisFileDirectory)..\ThirdParty\MSTest\v16\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition="'$(VisualStudioVersion)' == '17.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
          <Private>False</Private>
          <HintPath>$(MSBuildThisFileDirectory)..\ThirdParty\MSTest\v17\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition="'$(VisualStudioVersion)' == '18.0'">
      <ItemGroup>
        <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework">
          <Private>True</Private>
          <HintPath>$(PkgMicrosoft_TestPlatform)\tools\net462\Common7\IDE\Extensions\TestPlatform\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll</HintPath>
        </Reference>
      </ItemGroup>
    </When>
  </Choose>
</Project>
