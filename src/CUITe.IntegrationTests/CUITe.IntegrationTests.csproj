<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">10.0</VisualStudioVersion>
    <TargetFramework Condition="'$(VisualStudioVersion)' == ''">net40</TargetFramework>
    <TargetFramework Condition="'$(VisualStudioVersion)' == '10.0'">net40</TargetFramework>
    <TargetFramework Condition="'$(VisualStudioVersion)' == '17.0'">net472</TargetFramework>
    <TargetFramework Condition="'$(VisualStudioVersion)' == '18.0'">net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CUITe.IntegrationTests</RootNamespace>
    <AssemblyName>CUITe.IntegrationTests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\CUITe.snk</AssemblyOriginatorKeyFile>
    <IsCodedUITest>True</IsCodedUITest>
    <TestProjectType>CodedUITest</TestProjectType>
  </PropertyGroup>
  <Import Project="..\Project.props" />
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Web" />
    <Reference Include="WindowsBase" />
    <Reference Include="VSLangProj, Version=7.0.3300.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.TestTools.UITest.Extension.Silverlight, Version=12.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <HintPath>..\ThirdParty\CUIT\v12\Microsoft.VisualStudio.TestTools.UITest.Extension.Silverlight.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SpecFlow" Version="1.9.0" />
    <PackageReference Include="SpecBindGeneratorPlugin.SpecFlow" Version="1.6.2.232" />
    <PackageReference Include="SpecFlow.CustomPlugin" Version="1.9.0" />
    <PackageReference Include="VSLangProj" Version="7.0.3300" />
    <PackageReference Include="VSSDK.DTE" Version="7.0.4" />
    <PackageReference Include="VSSDK.DTE.8" Version="8.0.4" />
    <PackageReference Include="VSSDK.DTE.9" Version="9.0.4" />
    <PackageReference Include="VSSDK.DTE.10" Version="10.0.4" />
    <PackageReference Include="VSSDK.ComponentModelHost" Version="10.0.3" />
    <PackageReference Include="VSSDK.OLE.Interop" Version="7.0.4" />
    <PackageReference Include="VSSDK.Shell.10" Version="10.0.4" />
    <PackageReference Include="VSSDK.Shell.Immutable.10" Version="10.0.4" />
    <PackageReference Include="VSSDK.Shell.Interop" Version="7.0.4" />
    <PackageReference Include="VSSDK.Shell.Interop.8" Version="8.0.4" />
    <PackageReference Include="VSSDK.Shell.Interop.9" Version="9.0.4" />
    <PackageReference Include="VSSDK.Shell.Interop.10" Version="10.0.4" />
    <PackageReference Include="VSSDK.TextManager.Interop" Version="7.0.4" />
    <PackageReference Include="VSSDK.TextManager.Interop.8" Version="8.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs">
      <Link>Properties\CommonAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\SystemsUnderTest\TestHelpers\TempWebPage.cs">
      <Link>NuGet\TempWebPage.cs</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\CUITe.*.nupkg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\SystemsUnderTest\Sut.SilverlightTest\SilverlightControlTests.cs">
      <Link>NuGet\SilverlightControlTests.cs</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\SystemsUnderTest\Sut.SilverlightTest\PageObjects\TestPage.cs">
      <Link>NuGet\TestPage.cs</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="NuGet\HtmlTests.cs" />
    <EmbeddedResource Include="..\SystemsUnderTest\Sut.SilverlightTest\Sut.Silverlight.html">
      <Link>NuGet\Sut.Silverlight.html</Link>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(VisualStudioVersion)' == '18.0'">
    <EmbeddedResource Include="..\SystemsUnderTest\Sut.Silverlight\Bin\$(ConfigurationName)\VS2026\Sut.Silverlight.xap">
      <Link>NuGet\VisualStudio2026\Sut.Silverlight.xap</Link>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="NuGet\NuGet.feature">
      <Generator>SpecFlowSingleFileGenerator</Generator>
      <LastGenOutput>NuGet.feature.cs</LastGenOutput>
    </None>
    <None Include="ObjectRecorder\Features\Recording.feature">
      <Generator>SpecFlowSingleFileGenerator</Generator>
      <LastGenOutput>Recording.feature.cs</LastGenOutput>
    </None>
    <EmbeddedResource Include="NuGet\App.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CUITe\CUITe.csproj" />
    <ProjectReference Include="..\SystemsUnderTest\TestHelpers\TestHelpers.csproj" />
  </ItemGroup>
  <Import Project="$(SolutionDir)\Targets\CodedUITests.targets" />
  <Import Project="$(SolutionDir)\Targets\MSTest.targets" />
  <Import Project="$(SolutionDir)\Targets\CUIT.targets" />
  <Import Project="..\DefineNetFxCompilationConstants.prop" />
