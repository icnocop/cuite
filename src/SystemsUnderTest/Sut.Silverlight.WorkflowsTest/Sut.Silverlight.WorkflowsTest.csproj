<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">10.0</VisualStudioVersion>
    <TargetFramework Condition="'$(VisualStudioVersion)' == ''">net40</TargetFramework>
    <TargetFramework Condition="'$(VisualStudioVersion)' == '10.0'">net40</TargetFramework>
    <TargetFramework Condition="'$(VisualStudioVersion)' == '12.0'">net45</TargetFramework>
    <TargetFramework Condition="'$(VisualStudioVersion)' == '17.0'">net472</TargetFramework>
    <TargetFramework Condition="'$(VisualStudioVersion)' == '18.0'">net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Sut.Silverlight.WorkflowsTest</RootNamespace>
    <AssemblyName>Sut.Silverlight.WorkflowsTest</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <IsCodedUITest>True</IsCodedUITest>
    <TestProjectType>CodedUITest</TestProjectType>
  </PropertyGroup>
  <Import Project="..\..\Project.props" />
  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CassiniDev" Version="4.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\CommonAssemblyInfo.cs">
      <Link>Properties\CommonAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CUITe.Silverlight\CUITe.Silverlight.csproj" />
    <ProjectReference Include="..\..\CUITe\CUITe.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Sut.Silverlight.Workflows\Bin\$(Configuration)\Sut.Silverlight.Workflows.xap">
      <Link>Sut.Silverlight.Workflows.xap</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Sut.Silverlight.Workflows.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(SolutionDir)\Targets\CodedUITests.targets" />
  <Import Project="$(SolutionDir)\Targets\MSTest.targets" />
  <Import Project="$(SolutionDir)\Targets\CUIT.Silverlight.targets" />
</Project>
