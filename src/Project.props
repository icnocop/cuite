<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Normalize the target framework moniker for both SDK-style and non-SDK-style projects.
    SDK-style projects define $(TargetFramework) (e.g. net472) but $(TargetFrameworkVersion)
    is not resolved until later in the SDK targets.
    Non-SDK-style projects define $(TargetFrameworkVersion) (e.g. v4.7.2) directly.
  -->
  <PropertyGroup>
    <_CUITeTargetFramework Condition="'$(TargetFramework)' != ''">$(TargetFramework)</_CUITeTargetFramework>
    <_CUITeTargetFramework Condition="'$(_CUITeTargetFramework)' == '' And '$(TargetFrameworkVersion)' == 'v4.0'">net40</_CUITeTargetFramework>
    <_CUITeTargetFramework Condition="'$(_CUITeTargetFramework)' == '' And '$(TargetFrameworkVersion)' == 'v4.5'">net45</_CUITeTargetFramework>
    <_CUITeTargetFramework Condition="'$(_CUITeTargetFramework)' == '' And '$(TargetFrameworkVersion)' == 'v4.7.2'">net472</_CUITeTargetFramework>
  </PropertyGroup>
  <!-- Map $(VisualStudioVersion) to a display name used in output paths -->
  <PropertyGroup>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '10.0'">VS2010</_CUITeVSName>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '11.0'">VS2012</_CUITeVSName>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '12.0'">VS2013</_CUITeVSName>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '14.0'">VS2015</_CUITeVSName>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '15.0'">VS2017</_CUITeVSName>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '16.0'">VS2019</_CUITeVSName>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '17.0'">VS2022</_CUITeVSName>
    <_CUITeVSName Condition="'$(VisualStudioVersion)' == '18.0'">VS2026</_CUITeVSName>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '10.0'">$(DefineConstants);VS2010;</DefineConstants>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '11.0'">$(DefineConstants);VS2012;</DefineConstants>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '12.0'">$(DefineConstants);VS2013;</DefineConstants>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '14.0'">$(DefineConstants);VS2015;</DefineConstants>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '15.0'">$(DefineConstants);VS2017;</DefineConstants>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '16.0'">$(DefineConstants);VS2019;</DefineConstants>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '17.0'">$(DefineConstants);VS2022;</DefineConstants>
    <DefineConstants Condition="'$(VisualStudioVersion)' == '18.0'">$(DefineConstants);VS2026;</DefineConstants>
  </PropertyGroup>
  <!-- Shared output paths (use $(Configuration) to avoid duplicating Debug/Release) -->
  <PropertyGroup>
    <!--
      SDK-style projects automatically append $(TargetFramework) to OutputPath.
      Disable that behaviour so the explicit $(_CUITeTargetFramework) segment below
      is the single source of the TFM in the path for both project styles.
    -->
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFramework)' != ''">false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(_CUITeVSName)' != '' And '$(_CUITeTargetFramework)' != ''">bin\$(Configuration)\$(_CUITeVSName)\$(_CUITeTargetFramework)\</OutputPath>
    <SilverlightOutputPath Condition="'$(_CUITeVSName)' != ''">bin\$(Configuration)\$(_CUITeVSName)\</SilverlightOutputPath>
    <DocumentationFile Condition="'$(_CUITeVSName)' != '' And '$(_CUITeTargetFramework)' != ''">bin\$(Configuration)\$(_CUITeVSName)\$(_CUITeTargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- Debug-specific settings -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);TRACE;DEBUG</DefineConstants>
  </PropertyGroup>
  <!-- Release-specific settings -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>
</Project>